function itemKey(it){ return `${it.code}||${it.cat}||${it.sub}||${it.svc}`; }

function loadMeta(){
  try{ return JSON.parse(localStorage.getItem(LS_KEY) || "{}"); }catch{ return {}; }
}
function saveMeta(meta){
  localStorage.setItem(LS_KEY, JSON.stringify(meta));
}
let meta = loadMeta();

function ensureMetaKey(key){
  if(!meta[key]) meta[key] = {};
  if(!Array.isArray(meta[key].variants)) meta[key].variants = [];
  if(typeof meta[key].serviceNotes !== "string") meta[key].serviceNotes = "";
  return meta[key];
}

/** =========================
 *  Dropdowns
 *  ========================= */
function fillCategories(){
  const cats = uniq(baseServices.map(x=>x.cat));
  cats.forEach(c=>{
    const opt = document.createElement("option");
    opt.value = c; opt.textContent = c;
    catSel.appendChild(opt);
  });
}
function fillSubcategories(){
  subSel.innerHTML = `<option value="">Todas</option>`;
  const cat = catSel.value;
  const subs = uniq(baseServices.filter(x=>!cat || x.cat===cat).map(x=>x.sub));
  subs.forEach(s=>{
    const opt = document.createElement("option");
    opt.value = s; opt.textContent = s;
    subSel.appendChild(opt);
  });
}

/** =========================
 *  Filtro actual
 *  ========================= */
function currentFiltered(){
  const nq = norm(q.value);
  const cat = catSel.value;
  const sub = subSel.value;
  const dupOnly = onlyDup.checked;

  return baseServices
    .filter(it => (!cat || it.cat===cat))
    .filter(it => (!sub || it.sub===sub))
    .filter(it => (!dupOnly || codeFreq[it.code] > 1))
    .filter(it => {
      if(!nq) return true;
      const hay = norm([it.code,it.cat,it.sub,it.svc,it.desc].join(" | "));
      return hay.includes(nq);
    })
    .sort((a,b)=>a.code.localeCompare(b.code,'es'));
}

/** =========================
 *  Variaciones (plantillas)
 *  ========================= */
function templateVariants(type){
  const sheet = ({medida, color, unidad}) =>
    `Medida: ${medida} · Unidad: ${unidad} · Color: ${color} · Papel: [PAPEL] · Gramaje: [GRAMAJE] · Acabado: [ACABADO] · Tiempo de producción: [TIEMPO_PRODUCCION] · Tiempo de entrega: [TIEMPO_ENTREGA] · Observaciones: [NOTAS]`;

  switch(type){
    case "DTF_BASE":
      return [
        { name:"XS · hasta 10×10 cm", price:"[PRECIO]", unit:"por transfer", notes: sheet({medida:"Hasta 10×10 cm", color:"CMYK", unidad:"por transfer"}) },
        { name:"S · hasta 15×15 cm",  price:"[PRECIO]", unit:"por transfer", notes: sheet({medida:"Hasta 15×15 cm", color:"CMYK", unidad:"por transfer"}) },
        { name:"M · hasta 20×25 cm",  price:"[PRECIO]", unit:"por transfer", notes: sheet({medida:"Hasta 20×25 cm", color:"CMYK", unidad:"por transfer"}) },
        { name:"L · hasta 30×30 cm",  price:"[PRECIO]", unit:"por transfer", notes: sheet({medida:"Hasta 30×30 cm", color:"CMYK", unidad:"por transfer"}) },
        { name:"XL · hasta 33×48 cm", price:"[PRECIO]", unit:"por transfer", notes: sheet({medida:"Hasta 33×48 cm", color:"CMYK", unidad:"por transfer"}) },
        { name:"Metro lineal · 100×58 cm", price:"[380–480]", unit:"por metro", notes: sheet({medida:"100×58 cm", color:"CMYK", unidad:"por metro"}) },
        { name:"Medida especial", price:"[0.10/cm²]", unit:"por cm²", notes: sheet({medida:"[MEDIDA]", color:"CMYK", unidad:"por cm²"}) },
      ];

    case "FLYER_OFFSET_1000": {
      const unidad = "por 1000 pzas";
      return [
        { name:"Cuarto carta · 4x1 (CMYK/—)", price:"[PRECIO]", unit:unidad, notes: sheet({medida:"Cuarto carta [MEDIDA]", color:"4x1 (CMYK/—) tiro/retiro", unidad}) },
        { name:"Cuarto carta · 4x4 (CMYK/CMYK)", price:"[PRECIO]", unit:unidad, notes: sheet({medida:"Cuarto carta [MEDIDA]", color:"4x4 (CMYK/CMYK) tiro/retiro", unidad}) },

        { name:"Media carta · 4x1 (CMYK/—)",  price:"[PRECIO]", unit:unidad, notes: sheet({medida:"Media carta [MEDIDA]", color:"4x1 (CMYK/—) tiro/retiro", unidad}) },
        { name:"Media carta · 4x4 (CMYK/CMYK)",  price:"[PRECIO]", unit:unidad, notes: sheet({medida:"Media carta [MEDIDA]", color:"4x4 (CMYK/CMYK) tiro/retiro", unidad}) },

        { name:"Carta · 4x1 (CMYK/—)",        price:"[PRECIO]", unit:unidad, notes: sheet({medida:"Carta [MEDIDA]", color:"4x1 (CMYK/—) tiro/retiro", unidad}) },
        { name:"Carta · 4x4 (CMYK/CMYK)",        price:"[PRECIO]", unit:unidad, notes: sheet({medida:"Carta [MEDIDA]", color:"4x4 (CMYK/CMYK) tiro/retiro", unidad}) },
      ];
    }

    case "PLAYERA_TALLAS":
      return [
        { name:"Talla S", price:"[PRECIO]", unit:"por pieza", notes: sheet({medida:"Talla S", color:"[COLOR_IMPRESION] / Prenda: [COLOR_PRENDA]", unidad:"por pieza"}) },
        { name:"Talla M", price:"[PRECIO]", unit:"por pieza", notes: sheet({medida:"Talla M", color:"[COLOR_IMPRESION] / Prenda: [COLOR_PRENDA]", unidad:"por pieza"}) },
        { name:"Talla L", price:"[PRECIO]", unit:"por pieza", notes: sheet({medida:"Talla L", color:"[COLOR_IMPRESION] / Prenda: [COLOR_PRENDA]", unidad:"por pieza"}) },
        { name:"Talla XL", price:"[PRECIO]", unit:"por pieza", notes: sheet({medida:"Talla XL", color:"[COLOR_IMPRESION] / Prenda: [COLOR_PRENDA]", unidad:"por pieza"}) },
        { name:"Talla XXL", price:"[PRECIO]", unit:"por pieza", notes: sheet({medida:"Talla XXL", color:"[COLOR_IMPRESION] / Prenda: [COLOR_PRENDA]", unidad:"por pieza"}) },
      ];

    case "ESTRATEGIA_BPP":
      return [
        { name:"Básico",  price:"[PRECIO]", unit:"por proyecto", notes: sheet({medida:"Paquete Básico", color:"N/A", unidad:"por proyecto"}) + " · Alcance: [ALCANCE] · Revisiones: [REVISIONES]" },
        { name:"Pro",     price:"[PRECIO]", unit:"por proyecto", notes: sheet({medida:"Paquete Pro", color:"N/A", unidad:"por proyecto"}) + " · Alcance: [ALCANCE] · Revisiones: [REVISIONES]" },
        { name:"Premium", price:"[PRECIO]", unit:"por proyecto", notes: sheet({medida:"Paquete Premium", color:"N/A", unidad:"por proyecto"}) + " · Alcance: [ALCANCE] · Revisiones: [REVISIONES]" },
      ];

    default:
      return [];
  }
}

/** =========================
 *  Modal Variaciones
 *  ========================= */
function openVariants(key, title){
  activeVarKey = key;
  vTitle.textContent = title;

  const m = ensureMetaKey(activeVarKey);
  svcNotes.value = m.serviceNotes || "";
  vSearch.value = "";
  vSearchValue = "";

  renderVariants();
  vDialog.showModal();
}

function renderVariants(){
  const vars = meta[activeVarKey]?.variants || [];
  vBody.innerHTML = "";

  const qv = norm(vSearchValue);

  vars.forEach((v, idx) => {
    const hay = norm([v.name, v.price, v.unit, v.notes].join(" | "));
    const match = !qv || hay.includes(qv);

    const tr = document.createElement("tr");
    if(!match) tr.hidden = true;

    tr.innerHTML = `
      <td><input class="vedit" data-vidx="${idx}" data-vfield="name" placeholder="Ej. Cuarto carta · 4x4 (CMYK/CMYK)" value="${escapeHtml(v.name ?? "")}"></td>
      <td><input class="vedit" data-vidx="${idx}" data-vfield="price" inputmode="decimal" placeholder="Ej. 2500 / 380–480 / 0.10/cm²" value="${escapeHtml(v.price ?? "")}"></td>
      <td><input class="vedit" data-vidx="${idx}" data-vfield="unit" placeholder="Ej. por 1000 pzas / por pieza / por metro" value="${escapeHtml(v.unit ?? "")}"></td>
      <td><textarea class="vedit" data-vidx="${idx}" data-vfield="notes" placeholder="Ficha técnica…">${escapeHtml(v.notes ?? "")}</textarea></td>
      <td>
        <div class="row" style="justify-content:flex-end; gap:8px;">
          <button type="button" class="btn btn-mini" data-vup="${idx}" ${idx===0 ? "disabled" : ""}>Subir</button>
          <button type="button" class="btn btn-mini" data-vdown="${idx}" ${idx===vars.length-1 ? "disabled" : ""}>Bajar</button>
          <button type="button" class="btn btn-mini" data-vdup="${idx}">Duplicar</button>
          <button type="button" class="btn danger btn-mini" data-vremove="${idx}">Quitar</button>
        </div>
      </td>
    `;
    vBody.appendChild(tr);
  });
}

/** =========================
 *  Render tabla principal
 *  ========================= */
function render(){
  const list = currentFiltered();
  countEl.textContent = String(list.length);
  tbody.innerHTML = "";

  const frag = document.createDocumentFragment();
  let rowN = 0;

  for(const it of list){
    const key = itemKey(it);
    const m = ensureMetaKey(key);
    const isDup = codeFreq[it.code] > 1;
    const variants = m.variants || [];
    const vlistId = `vlist_${rowN++}`;

    const preview = variants.slice(0,2).map(v=>{
      const p = (v.price ?? "").toString().trim();
      return `${v.name || "—"}${p ? ` — $${p}` : ""}`;
    }).join("<br>");

    const listHtml = variants.map(v=>{
      const p = (v.price ?? "").toString().trim();
      const u = (v.unit ?? "").toString().trim();
      const notes = trunc(v.notes ?? "", 160);
      return `
        <div class="vitem">
          <div class="top">
            <div class="vname">${escapeHtml(v.name || "—")}</div>
            <div class="vmeta">${p ? "$"+escapeHtml(p) : ""}${(p && u) ? " · " : ""}${escapeHtml(u)}</div>
          </div>
          ${notes ? `<div class="mini" style="margin-top:6px;">${escapeHtml(notes)}</div>` : ``}
        </div>
      `;
    }).join("");

    const tr = document.createElement("tr");

    const tdCode = document.createElement("td");
    tdCode.innerHTML = `
      <div class="code">
        <span>${escapeHtml(it.code)}</span>
        ${isDup ? `<span class="tag dup">DUP</span>` : ``}
      </div>
      <div style="margin-top:8px;">
        <button class="copy" data-copy="${escapeHtml(it.code)}">COPIAR</button>
      </div>
    `;
    tr.appendChild(tdCode);

    const tdCat = document.createElement("td");
    tdCat.innerHTML = `<span class="tag"><span class="bar"></span><span>${escapeHtml(it.cat)}</span></span>`;
    tr.appendChild(tdCat);

    const tdSub = document.createElement("td");
    tdSub.textContent = it.sub;
    tr.appendChild(tdSub);

    const tdSvc = document.createElement("td");
    tdSvc.innerHTML = `
      <div class="svc">${escapeHtml(it.svc)}</div>
      <div class="mini" style="margin-top:6px;">${escapeHtml(it.desc || "—")}</div>
    `;
    tr.appendChild(tdSvc);

    const tdVar = document.createElement("td");
    const canView = variants.length > 0;
    tdVar.innerHTML = `
      <div class="row" style="gap:8px; align-items:flex-start;">
        <span class="tag"><span class="bar"></span><span>${variants.length} vars</span></span>

        <button class="btn btn-mini" data-toggle="${vlistId}" aria-expanded="false" ${canView ? "" : "disabled"}>
          Ver todas
        </button>

        <button class="btn btn-mini" data-variants="${escapeHtml(key)}"
          data-title="${escapeHtml(it.code)} · ${escapeHtml(it.svc)}">
          Editar
        </button>
      </div>

      <div class="mini" style="margin-top:8px;">${preview || "—"}</div>

      <div id="${vlistId}" class="vlist" hidden>
        ${m.serviceNotes ? `<div class="mini" style="margin-bottom:10px;"><strong>Notas globales:</strong> ${escapeHtml(trunc(m.serviceNotes, 260))}</div>` : ``}
        ${listHtml || `<div class="mini">Sin variaciones.</div>`}
      </div>
    `;
    tr.appendChild(tdVar);

    frag.appendChild(tr);
  }

  tbody.appendChild(frag);
}

/** =========================
 *  Eventos (tabla principal)
 *  ========================= */
document.addEventListener("click", async (e)=>{
  // Toggle ver todas
  const tBtn = e.target.closest("[data-toggle]");
  if(tBtn){
    const id = tBtn.dataset.toggle;
    const el = document.getElementById(id);
    if(!el) return;

    const isOpen = !el.hasAttribute("hidden");
    if(isOpen){
      el.setAttribute("hidden", "");
      tBtn.textContent = "Ver todas";
      tBtn.setAttribute("aria-expanded", "false");
    }else{
      el.removeAttribute("hidden");
      tBtn.textContent = "Ocultar";
      tBtn.setAttribute("aria-expanded", "true");
    }
    return;
  }

  // Copiar
  const copyBtn = e.target.closest("[data-copy]");
  if(copyBtn){
    const val = copyBtn.getAttribute("data-copy");
    try{
      await navigator.clipboard.writeText(val);
      toastMsg("Código copiado: " + val);
    }catch{
      const ta = document.createElement("textarea");
      ta.value = val; document.body.appendChild(ta);
      ta.select(); document.execCommand("copy");
      ta.remove();
      toastMsg("Código copiado: " + val);
    }
    return;
  }

  // Abrir modal
  const vBtn = e.target.closest("[data-variants]");
  if(vBtn){
    openVariants(vBtn.dataset.variants, vBtn.dataset.title);
    return;
  }
});

q.addEventListener("input", render);
catSel.addEventListener("change", ()=>{ fillSubcategories(); render(); });
subSel.addEventListener("change", render);
onlyDup.addEventListener("change", render);

$("#resetLocal").addEventListener("click", ()=>{
  if(!confirm("¿Seguro? Esto borra variaciones y notas globales guardadas en este navegador.")) return;
  localStorage.removeItem(LS_KEY);
  meta = loadMeta();
  render();
  toastMsg("Datos locales reseteados");
});

/** =========================
 *  Eventos (modal variaciones)
 *  ========================= */
vSearch.addEventListener("input", ()=>{
  vSearchValue = vSearch.value;
  renderVariants();
});

svcNotes.addEventListener("input", ()=>{
  if(!activeVarKey) return;
  ensureMetaKey(activeVarKey);
  meta[activeVarKey].serviceNotes = svcNotes.value;
  saveMeta(meta);
  render();
});

vDialog.addEventListener("input", (e) => {
  const fieldEl = e.target.closest("[data-vfield]");
  if(!fieldEl || !activeVarKey) return;

  const idx = Number(fieldEl.dataset.vidx);
  const field = fieldEl.dataset.vfield;

  ensureMetaKey(activeVarKey);
  if(!meta[activeVarKey].variants[idx]) meta[activeVarKey].variants[idx] = {name:"",price:"",unit:"",notes:""};
  meta[activeVarKey].variants[idx][field] = fieldEl.value;

  saveMeta(meta);
  render();
});

vDialog.addEventListener("click", (e) => {
  if(!activeVarKey) return;

  const m = ensureMetaKey(activeVarKey);
  const vars = m.variants;

  // subir
  const up = e.target.closest("[data-vup]");
  if(up){
    const idx = Number(up.dataset.vup);
    if(idx > 0){
      [vars[idx-1], vars[idx]] = [vars[idx], vars[idx-1]];
      saveMeta(meta);
      renderVariants();
      render();
    }
    return;
  }

  // bajar
  const down = e.target.closest("[data-vdown]");
  if(down){
    const idx = Number(down.dataset.vdown);
    if(idx < vars.length - 1){
      [vars[idx+1], vars[idx]] = [vars[idx], vars[idx+1]];
      saveMeta(meta);
      renderVariants();
      render();
    }
    return;
  }

  // duplicar
  const dup = e.target.closest("[data-vdup]");
  if(dup){
    const idx = Number(dup.dataset.vdup);
    const original = vars[idx] || {name:"",price:"",unit:"",notes:""};
    const copy = JSON.parse(JSON.stringify(original));
    vars.splice(idx + 1, 0, copy);
    saveMeta(meta);
    renderVariants();
    render();
    return;
  }

  // quitar
  const rm = e.target.closest("[data-vremove]");
  if(rm){
    const idx = Number(rm.dataset.vremove);
    vars.splice(idx, 1);
    saveMeta(meta);
    renderVariants();
    render();
    return;
  }
});

addVarBtn.addEventListener("click", () => {
  if(!activeVarKey) return;
  ensureMetaKey(activeVarKey);
  meta[activeVarKey].variants.push({
    name: "Base",
    price: "[PRECIO]",
    unit: "[UNIDAD]",
    notes: "Medida: [MEDIDA] · Unidad: [UNIDAD] · Color: [COLOR] · Papel: [PAPEL] · Gramaje: [GRAMAJE] · Acabado: [ACABADO] · Tiempo de producción: [TIEMPO_PRODUCCION] · Tiempo de entrega: [TIEMPO_ENTREGA] · Observaciones: [NOTAS]"
  });
  saveMeta(meta);
  renderVariants();
  render();
});

closeVarBtn.addEventListener("click", () => {
  vDialog.close();
  activeVarKey = null;
  vSearchValue = "";
  render();
});

// Plantillas
applyTplBtn.addEventListener("click", () => {
  if(!activeVarKey) return;
  const type = tplSel.value;
  if(!type) return;

  const vars = templateVariants(type);
  if(!vars.length) return;

  if(!confirm("Esto REEMPLAZA las variaciones actuales. ¿Continuar?")) return;
  ensureMetaKey(activeVarKey);
  meta[activeVarKey].variants = vars;
  saveMeta(meta);
  renderVariants();
  render();
});

appendTplBtn.addEventListener("click", () => {
  if(!activeVarKey) return;
  const type = tplSel.value;
  if(!type) return;

  const vars = templateVariants(type);
  if(!vars.length) return;

  ensureMetaKey(activeVarKey);
  meta[activeVarKey].variants.push(...vars);
  saveMeta(meta);
  renderVariants();
  render();
});

/** =========================
 *  Export CSV
 *  ========================= */
function variantsToText(vars){
  if(!Array.isArray(vars) || !vars.length) return "";
  return vars.map(v => {
    const a = (v.name ?? "").trim();
    const b = (v.price ?? "").trim();
    const c = (v.unit ?? "").trim();
    const d = (v.notes ?? "").trim().replaceAll("\n"," ");
    return `${a} | $${b} | ${c} | ${d}`;
  }).join(" ; ");
}

function toCSV(rows){
  const header = [
    "Código","Categoría","Subcategoría","Servicio","Descripción",
    "Notas globales",
    "Variaciones (count)","Variaciones (texto)"
  ];
  const esc = (v)=> `"${String(v ?? "").replaceAll('"','""')}"`;
  const lines = [header.map(esc).join(",")];

  rows.forEach(it=>{
    const k = itemKey(it);
    const m = ensureMetaKey(k);
    const vars = m.variants || [];
    lines.push([
      it.code,it.cat,it.sub,it.svc,it.desc,
      m.serviceNotes ?? "",
      vars.length,
      variantsToText(vars),
    ].map(esc).join(","));
  });

  return lines.join("\n");
}

$("#exportCsv").addEventListener("click", ()=>{
  const rows = currentFiltered();
  const csv = toCSV(rows);
  const blob = new Blob([csv], {type:"text/csv;charset=utf-8"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "catalogo-servicios-interno.csv";
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
  toastMsg("CSV exportado");
});

/** =========================
 *  Init
 *  ========================= */
fillCategories();
fillSubcategories();
render();
</script>
