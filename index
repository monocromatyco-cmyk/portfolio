<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Catálogo Interno · Códigos de Servicios</title>

  <!-- Opcional (requiere internet) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#f5f7ff;
      --card:#ffffff;

      --text:#0b1220;
      --muted:#5b677a;

      --line:rgba(15,23,42,.10);
      --line2:rgba(15,23,42,.16);

      --accent:#2563eb;
      --accent2:#38bdf8;

      --danger:#e11d48;

      --radius:16px;
      --shadow: 0 12px 30px rgba(2,6,23,.10);
    }

    *{ box-sizing:border-box; }
    html,body{ height:100%; }

    body{
      margin:0;
      background:
        radial-gradient(1200px 800px at 75% -10%, rgba(37,99,235,.10), transparent 55%),
        radial-gradient(900px 650px at 5% 10%, rgba(56,189,248,.10), transparent 45%),
        var(--bg);
      color:var(--text);
      font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    }

    .wrap{
      max-width: 1280px;
      margin: 28px auto 56px;
      padding: 0 18px;
    }

    header{
      display:flex;
      align-items:stretch;
      justify-content:space-between;
      gap:16px;
      margin-bottom: 16px;
    }

    .title{
      padding: 18px 18px 16px;
      border:1px solid var(--line);
      background: var(--card);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      flex:1;
      min-width: 280px;
    }

    .kicker{
      font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--muted);
      font-size: 12px;
    }

    h1{
      margin:10px 0 8px;
      font-size: 26px;
      letter-spacing: .01em;
      line-height:1.15;
    }

    .sub{
      margin:0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.4;
      max-width: 95ch;
    }

    .badge-internal{
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--card);
      box-shadow: var(--shadow);
      padding: 18px;
      min-width: 240px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      gap:10px;
    }
    .badge-internal .big{
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      letter-spacing:.22em;
      text-transform: uppercase;
      font-size: 12px;
      color: var(--muted);
    }
    .badge-internal .mark{
      display:flex;
      align-items:center;
      gap:10px;
      font-weight: 600;
    }
    .dot{
      width:10px;height:10px;border-radius:999px;
      background: var(--accent);
      box-shadow: 0 0 0 6px rgba(37,99,235,.10);
    }

    .panel{
      border:1px solid var(--line);
      background: var(--card);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow:hidden;
    }

    .panel-head{
      padding: 14px 16px 12px;
      display:flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items: end;
      border-bottom: 1px solid var(--line);
      background: rgba(255,255,255,.75);
      backdrop-filter: blur(10px);
    }

    .field{
      display:flex;
      flex-direction:column;
      gap:8px;
      min-width: 190px;
    }

    label{
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .18em;
      color: var(--muted);
      font-family: "IBM Plex Mono", ui-monospace, monospace;
    }

    input[type="search"], select{
      width: 100%;
      border-radius: 12px;
      border:1px solid var(--line2);
      background: #fff;
      color: var(--text);
      padding: 10px 12px;
      outline:none;
    }
    input[type="search"]::placeholder{ color: rgba(91,103,122,.7); }

    .row{
      display:flex; gap:10px; align-items:center; flex-wrap: wrap;
    }

    .btn{
      border: 1px solid var(--line2);
      background: #fff;
      color: var(--text);
      padding: 10px 12px;
      border-radius: 12px;
      cursor:pointer;
      font-weight: 600;
      letter-spacing: .01em;
    }
    .btn:hover{ border-color: rgba(15,23,42,.28); }
    .btn:active{ transform: translateY(1px); }
    .btn:disabled{ opacity:.55; cursor:not-allowed; }

    .btn.primary{
      border-color: rgba(37,99,235,.35);
      background: rgba(37,99,235,.08);
    }
    .btn.danger{
      border-color: rgba(225,29,72,.28);
      background: rgba(225,29,72,.06);
    }
    .btn-mini{
      padding: 8px 10px;
      border-radius: 10px;
      font-size: 12px;
    }

    .stats{
      margin-left:auto;
      display:flex;
      gap:10px;
      flex-wrap: wrap;
      align-items:center;
      color: var(--muted);
      font-size: 12px;
    }
    .pill{
      border:1px solid var(--line);
      border-radius: 999px;
      padding: 7px 10px;
      background: rgba(37,99,235,.04);
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      letter-spacing: .06em;
    }
    .pill strong{ color: var(--text); font-weight: 700; }

    .toggle{
      display:flex; align-items:center; gap:10px;
      padding: 10px 12px;
      border:1px solid var(--line2);
      border-radius: 12px;
      background: #fff;
      user-select:none;
    }
    .toggle input{ width:16px; height:16px; }

    .table-wrap{
      overflow:auto;
      max-height: calc(100vh - 260px);
    }

    table{
      width:100%;
      border-collapse: separate;
      border-spacing: 0;
      min-width: 1100px;
    }

    thead th{
      position: sticky;
      top:0;
      z-index: 3;
      background: rgba(255,255,255,.94);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line2);
      color: var(--muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .18em;
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      padding: 12px 10px;
      text-align:left;
      white-space: nowrap;
    }

    tbody td{
      border-bottom: 1px solid var(--line);
      padding: 12px 10px;
      vertical-align: top;
      font-size: 13px;
      color: rgba(11,18,32,.95);
      background: transparent;
    }

    tbody tr:hover td{
      background: rgba(37,99,235,.04);
    }

    .code{
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      letter-spacing:.02em;
      display:flex;
      gap:10px;
      align-items:center;
      white-space: nowrap;
    }

    .mini{
      font-size: 11px;
      color: var(--muted);
    }

    .copy{
      border:1px solid var(--line2);
      background: #fff;
      color: var(--text);
      border-radius: 10px;
      padding: 6px 8px;
      cursor:pointer;
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      font-size: 11px;
    }
    .copy:hover{ border-color: rgba(37,99,235,.35); }

    .tag{
      display:inline-flex;
      align-items:center;
      gap:8px;
      border:1px solid var(--line);
      background: rgba(37,99,235,.04);
      padding: 6px 10px;
      border-radius: 999px;
      color: var(--muted);
      white-space: nowrap;
    }

    .tag .bar{
      width:9px; height:9px; border-radius: 999px;
      background: var(--accent2);
      box-shadow: 0 0 0 6px rgba(56,189,248,.12);
    }

    .dup{
      color: var(--danger);
      border-color: rgba(225,29,72,.25);
      background: rgba(225,29,72,.06);
      margin-left: 6px;
      font-weight: 800;
    }

    .svc{
      font-weight: 700;
      letter-spacing: .01em;
    }

    /* Variants list (collapsible) */
    .vlist{
      margin-top: 10px;
      padding: 10px;
      border: 1px dashed rgba(37,99,235,.35);
      border-radius: 12px;
      background: rgba(37,99,235,.04);
    }
    .vitem{
      padding: 8px 8px;
      border-bottom: 1px solid var(--line);
    }
    .vitem:last-child{ border-bottom: 0; padding-bottom: 0; }
    .vitem .top{
      display:flex;
      gap:10px;
      justify-content:space-between;
      align-items:baseline;
      flex-wrap: wrap;
    }
    .vname{
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      font-size: 12px;
      color: rgba(11,18,32,.92);
    }
    .vmeta{
      font-size: 12px;
      color: var(--muted);
      white-space: nowrap;
    }

    .foot{
      padding: 12px 16px;
      color: var(--muted);
      font-size: 12px;
      border-top: 1px solid var(--line);
      display:flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items:center;
      justify-content:space-between;
      background: rgba(245,247,255,.6);
    }
    .foot .hint{
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      letter-spacing: .06em;
    }

    /* Dialog */
    dialog{
      border:1px solid var(--line2);
      border-radius: var(--radius);
      padding:0;
      max-width: 1100px;
      width: calc(100% - 24px);
      box-shadow: var(--shadow);
      background: var(--card);
      color: var(--text);
    }
    dialog::backdrop{
      background: rgba(2,6,23,.35);
      backdrop-filter: blur(2px);
    }
    .dlg-head{ padding: 14px 16px; border-bottom: 1px solid var(--line); }
    .dlg-body{ padding: 14px 16px; }

    .vtools{
      margin-top: 12px;
      display:flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items: end;
      justify-content: space-between;
    }

    .vtable{ width:100%; border-collapse: separate; border-spacing: 0; min-width: 1040px; }
    .vtable th{
      text-align:left;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .18em;
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      color: var(--muted);
      padding: 10px 10px;
      border-bottom: 1px solid var(--line2);
      background: rgba(245,247,255,.85);
      position: sticky;
      top: 0;
    }
    .vtable td{
      padding: 10px;
      border-bottom: 1px solid var(--line);
      vertical-align: top;
    }
    .vedit{
      width: 100%;
      border-radius: 10px;
      border:1px solid var(--line2);
      background: #fff;
      color: var(--text);
      padding: 8px 10px;
      outline:none;
      font-size: 13px;
      font-family: inherit;
      resize: vertical;
      min-height: 38px;
    }
    textarea.vedit{ min-height: 74px; }

    .toast{
      position: fixed;
      left: 50%;
      bottom: 18px;
      transform: translateX(-50%);
      background: rgba(255,255,255,.92);
      border: 1px solid var(--line2);
      color: var(--text);
      padding: 10px 12px;
      border-radius: 999px;
      box-shadow: var(--shadow);
      font-size: 13px;
      opacity: 0;
      pointer-events: none;
      transition: opacity .2s ease, transform .2s ease;
    }
    .toast.show{ opacity: 1; transform: translateX(-50%) translateY(-2px); }
  </style>
</head>

<body>
  <div class="wrap">
    <header>
      <div class="title">
        <div class="kicker">Catálogo interno · Códigos base</div>
        <h1>Servicios · Variaciones · Precios (MXN)</h1>
        <p class="sub">
          Tabla compacta para uso interno. En “Variaciones” puedes cargar plantillas (Offset 1000, DTF, tallas, paquetes),
          reordenar con Subir/Bajar, duplicar y buscar dentro del listado.
        </p>
      </div>

      <aside class="badge-internal">
        <div class="big">Uso interno</div>
        <div class="mark"><span class="dot"></span> Variaciones como fuente de precio</div>
        <div class="mini">Exporta CSV cuando lo necesites.</div>
      </aside>
    </header>

    <section class="panel" aria-label="Filtros">
      <div class="panel-head">
        <div class="field" style="min-width: 320px; flex: 1;">
          <label for="q">Buscar</label>
          <input id="q" type="search" placeholder="Código, categoría, subcategoría, servicio o descripción…" />
        </div>

        <div class="field">
          <label for="cat">Categoría</label>
          <select id="cat">
            <option value="">Todas</option>
          </select>
        </div>

        <div class="field">
          <label for="sub">Subcategoría</label>
          <select id="sub">
            <option value="">Todas</option>
          </select>
        </div>

        <div class="field" style="min-width: 220px;">
          <label>Opciones</label>
          <div class="row">
            <label class="toggle" title="Muestra solo los códigos que se repiten">
              <input type="checkbox" id="onlyDup" />
              <span class="mini">Solo duplicados</span>
            </label>
          </div>
        </div>

        <div class="row" style="align-self:flex-end;">
          <button class="btn primary" id="exportCsv">Exportar CSV</button>
          <button class="btn danger" id="resetLocal">Reset variaciones/datos</button>
        </div>

        <div class="stats">
          <div class="pill">Mostrando <strong id="count">0</strong></div>
          <div class="pill">Duplicados <strong id="dupCount">0</strong></div>
        </div>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th style="width:170px;">Código</th>
              <th style="width:230px;">Categoría</th>
              <th style="width:220px;">Subcategoría</th>
              <th style="width:360px;">Servicio</th>
              <th style="width:420px;">Variaciones</th>
            </tr>
          </thead>
          <tbody id="tbody"></tbody>
        </table>
      </div>

      <div class="foot">
        <div class="hint">Offset: “4x1 / 4x4” está como CMYK tiro/retiro en la plantilla.</div>
        <div class="mini">Datos guardados en tu navegador (localStorage).</div>
      </div>
    </section>
  </div>

  <!-- Modal Variaciones -->
  <dialog id="variantsDialog">
    <div class="dlg">
      <div class="dlg-head">
        <div class="kicker">Variaciones / Presentaciones</div>
        <h2 id="vTitle" style="margin:8px 0 0; font-size:18px;">—</h2>
        <p class="sub" style="margin-top:8px;">
          Recomendación: maneja TODO como variaciones. Si un servicio solo tiene un precio, crea una variación “Base”.
        </p>

        <div class="vtools">
          <div class="row" style="gap:10px; flex-wrap:wrap; flex: 1;">
            <div class="field" style="min-width:320px; flex: 1;">
              <label for="vSearch">Buscar en variaciones</label>
              <input id="vSearch" type="search" placeholder="Nombre, precio, unidad o texto de ficha técnica…" />
            </div>

            <div class="field" style="min-width:360px;">
              <label for="tpl">Plantilla rápida</label>
              <select id="tpl">
                <option value="">Selecciona…</option>
                <option value="DTF_BASE">DTF (XS/S/M/L/XL + Metro + cm²)</option>
                <option value="FLYER_OFFSET_1000">Flyer Offset (Cuarto/Media/Carta · 4x1/4x4 · por 1000)</option>
                <option value="PLAYERA_TALLAS">Playeras (S/M/L/XL/XXL)</option>
                <option value="ESTRATEGIA_BPP">Estrategia (Básico/Pro/Premium)</option>
              </select>
            </div>

            <div class="row" style="align-self:flex-end;">
              <button type="button" class="btn primary" id="applyTpl">Aplicar (reemplaza)</button>
              <button type="button" class="btn" id="appendTpl">Aplicar (agrega)</button>
            </div>
          </div>
        </div>

        <div style="margin-top:12px;">
          <div class="field" style="min-width: 100%;">
            <label for="svcNotes">Notas globales del servicio (opcional)</label>
            <textarea id="svcNotes" class="vedit" placeholder="Notas que aplican a todas las variaciones (ej. condiciones, archivos, etc.)"></textarea>
          </div>
        </div>
      </div>

      <div class="dlg-body">
        <div style="overflow:auto; border:1px solid var(--line); border-radius: 12px;">
          <table class="vtable">
            <thead>
              <tr>
                <th style="width:240px;">Nombre</th>
                <th style="width:140px;">Precio (MXN)</th>
                <th style="width:170px;">Unidad</th>
                <th>Ficha técnica (Notas)</th>
                <th style="width:260px;"></th>
              </tr>
            </thead>
            <tbody id="vBody"></tbody>
          </table>
        </div>

        <div class="row" style="margin-top:12px; justify-content:space-between;">
          <button type="button" class="btn primary" id="addVar">Añadir variación</button>
          <div class="row">
            <button type="button" class="btn" id="closeVar">Cerrar</button>
          </div>
        </div>
      </div>
    </div>
  </dialog>

  <div class="toast" id="toast">Copiado</div>

<script>
/** =========================
 *  Base de servicios (del PDF)
 *  ========================= */
const baseServices = [
