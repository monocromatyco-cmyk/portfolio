function norm(s=""){ return stripAccents(String(s)).toLowerCase().trim(); }

function toastMsg(msg){
  toast.textContent = msg;
  toast.classList.add("show");
  setTimeout(()=>toast.classList.remove("show"), 950);
}

function uniq(arr){ return [...new Set(arr)].sort((a,b)=>a.localeCompare(b,'es')); }

function escapeHtml(str){
  return String(str)
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}

function trunc(str, n=170){
  const s = String(str ?? "").replaceAll("\n"," ").trim();
  if(!s) return "";
  return s.length > n ? s.slice(0, n-1) + "…" : s;
}

